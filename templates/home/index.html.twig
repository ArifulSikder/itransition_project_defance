{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-12">
        <h1 class="h3 mb-1">{{ 'home.hello'|trans }}</h1>
        <p class="text-secondary">{{ 'home.lead'|trans }}</p>
    </div>

    <div class="col-12">
        <div class="row g-3">
            {% for key, value in stats %}
                <div class="col-6 col-lg">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="text-secondary small">{{ ('stats.' ~ key)|trans }}</div>
                        <div class="fs-3 fw-semibold">{{ value }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="col-lg-7">
        <h2 class="h5">{{ 'home.latest'|trans }}</h2>
        <div class="table-responsive border rounded-3">
            <table class="table table-hover align-middle mb-0 js-data-table">
                <thead>
                <tr>
                    <th>{{ 'position.title'|trans }}</th>
                    <th>{{ 'position.company'|trans }}</th>
                    <th>{{ 'position.level'|trans }}</th>
                    <th>{{ 'position.updated'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for position in latest %}
                    <tr data-href="{{ path('position_show', {id: position.id}) }}">
                        <td>{{ position.title }}</td>
                        <td>{{ position.company }}</td>
                        <td>{{ position.level.label }}</td>
                        <td>{{ position.updatedAt|date('Y-m-d') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-secondary">{{ 'empty.positions'|trans }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-5">
        <h2 class="h5">{{ 'home.popular'|trans }}</h2>
        <div class="table-responsive border rounded-3 mb-4">
            <table class="table table-hover align-middle mb-0 js-data-table">
                <thead>
                <tr>
                    <th>{{ 'position.title'|trans }}</th>
                    <th>{{ 'position.cvs'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for position in popular %}
                    <tr data-href="{{ path('position_show', {id: position.id}) }}">
                        <td>{{ position.title }}</td>
                        <td>{{ position.cvCount }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="2" class="text-secondary">{{ 'empty.positions'|trans }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <h2 class="h5">{{ 'home.tags'|trans }}</h2>
        <div class="tag-cloud border rounded-3 p-3">
            {% for tag in tags %}
                {% set href = is_granted('ROLE_RECRUITER') ? path('app_search', {q: tag.name, type: 'cv'}) : path('position_index', {tag: tag.name}) %}
                <a class="tag-cloud-item" style="font-size: {{ 0.85 + (tag.weight / 8) }}rem" href="{{ href }}">{{ tag.name }}</a>
            {% else %}
                <span class="text-secondary">{{ 'empty.tags'|trans }}</span>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
