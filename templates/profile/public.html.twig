{% extends 'base.html.twig' %}
{% block title %}{{ profile.fullName }}{% endblock %}
{% block body %}
<h1 class="h3">{{ profile.fullName }}</h1>
<p class="text-secondary">{{ profile.location }}</p>
<h2 class="h5">{{ 'profile.cvs'|trans }}</h2>
<div class="table-responsive border rounded-3">
    <table class="table table-hover mb-0 js-data-table">
        <thead><tr><th>{{ 'position.title'|trans }}</th><th>{{ 'cv.likes'|trans }}</th></tr></thead>
        <tbody>
        {% for cv in cvs %}
            <tr data-href="{{ path('cv_show', {id: cv.id}) }}">
                <td>{{ cv.position.title }}</td>
                <td>{{ cv.likeCount }}</td>
            </tr>
        {% else %}
            <tr><td colspan="2" class="text-secondary">{{ 'empty.cvs'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
